# Network configuration.
#
# PI_IP / PROXY_PORT / PROXY_BIND_IP are the primary configuration and are
# always required.
#
# BOSE_IP, SPEAKER_NAME and ACTIVE_ZONE_NAME are FALLBACK values used only
# when soundtouch-radio/speakers.json is missing. Once you create
# speakers.json (or edit it from the Node-RED dashboard) the bridge and
# proxy ignore them and drive every speaker listed there instead. The
# shell helpers in soundtouch-radio/soundtouch-api/ still use BOSE_IP as
# the default target when called without a <speaker-id> argument.

FOLDER=/home/pi/BoseSoundtouchReplacement/soundtouch-radio
PI_IP=10.0.0.241
PROXY_PORT=8091
PROXY_BIND_IP=0.0.0.0

# Fallback single-speaker configuration (used when speakers.json is absent):
BOSE_IP=10.0.0.199
SPEAKER_NAME=Living Room
ACTIVE_ZONE_NAME=
