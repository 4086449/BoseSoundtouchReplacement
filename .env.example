# Copy to .env and edit for your environment.
# All values have safe defaults baked into docker-compose.yml.

TZ=Europe/Brussels

# Bose SoundTouch device (master). Add more devices later in node-red/data/presets.json.
BOSE_HOST=10.0.0.199
BOSE_PORT=8090

# Hasselt, BE - used for Radio Browser geo-distance ranking.
GEO_LAT=50.9307
GEO_LON=5.3325

# Required by Radio Browser usage policy.
RB_USER_AGENT=SoundTouchReplacement/0.1

# Gerbera UI/REST endpoint reachable from Node-RED.
# Gerbera runs network_mode: host on the Pi, so Node-RED reaches it via the Pi's LAN IP.
GERBERA_URL=http://10.0.0.241:49152
