[Unit]
Description=SoundTouch radio stream proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/BoseSoundtouchReplacement/soundtouch-radio/proxy
ExecStart=/usr/bin/python3 /home/pi/BoseSoundtouchReplacement/soundtouch-radio/proxy/radio-proxy.py
EnvironmentFile=/home/pi/BoseSoundtouchReplacement/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
