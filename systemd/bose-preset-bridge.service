[Unit]
Description=Bose SoundTouch hardware preset to UPnP bridge
After=network-online.target soundtouch-radio-proxy.service
Wants=network-online.target soundtouch-radio-proxy.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/BoseSoundtouchReplacement/soundtouch-radio/bridge
ExecStart=/home/pi/BoseSoundtouchReplacement/soundtouch-radio/bridge/venv/bin/python /home/pi/BoseSoundtouchReplacement/soundtouch-radio/bridge/bose-preset-bridge.py
EnvironmentFile=/home/pi/BoseSoundtouchReplacement/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
