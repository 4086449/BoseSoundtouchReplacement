<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gerbera minimal config for SoundTouch Radio Relay.

  Items are added at runtime by the Node-RED "rebuild gerbera library" flow.
  We deliberately do NOT override <home>, <webroot>, or <storage> paths -
  Gerbera 3.x in the official image picks correct defaults for those, and
  hard-coding them broke startup ("Directory '/usr/share/gerbera/web' does
  not exist").
-->
<config version="2"
        xmlns="http://mediatomb.cc/config/2"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://mediatomb.cc/config/2 http://mediatomb.cc/config/2.xsd">
  <server>
    <ui enabled="yes" show-tooltips="yes">
      <accounts enabled="no" session-timeout="30"/>
    </ui>
    <name>SoundTouch Radio Relay</name>
    <udn>uuid:5f8d5a8a-soundtouch-radio-relay-0001</udn>
    <webroot>/usr/local/share/gerbera/web</webroot>
    <storage>
      <sqlite3 enabled="yes">
        <database-file>/var/lib/gerbera/gerbera.db</database-file>
      </sqlite3>
    </storage>
    <protocolInfo extend="yes"/>
  </server>

  <import hidden-files="no">
    <mappings>
      <extension-mimetype ignore-unknown="no">
        <map from="mp3" to="audio/mpeg"/>
        <map from="aac" to="audio/aac"/>
        <map from="m4a" to="audio/mp4"/>
        <map from="ogg" to="audio/ogg"/>
        <map from="flac" to="audio/flac"/>
      </extension-mimetype>
      <mimetype-upnpclass>
        <map from="audio/*" to="object.item.audioItem.audioBroadcast"/>
      </mimetype-upnpclass>
    </mappings>
  </import>
</config>

